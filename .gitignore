# ─────────────────────────────────────────────────────────────
# PUBLIC REPOSITORY. What enters the history never leaves.
# When in doubt, do not commit.
# ─────────────────────────────────────────────────────────────

# Credentials. The real .env lives outside the repository; these rules
# are a second barrier, not the main one.
.env
.env.*
!.env.example
*.ini
*.pem
*.key
*.p12
*.pfx

# Real tally sheets: the PAdES signature carries personal data of the
# polling station members. Only synthetic fixtures under tests/ are versioned.
data/records/
data/custody/

# Derived artefacts: regenerated by tools/render_pages.py
data/cache/
data/og/
data/pages/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Logs and temporaries
*.log
error_log
.DS_Store

# Staging destination for the preview: belongs to the operator, not the repo
tools/deploy.env
