# Credenciales. Viven en /home/votolibre/config/peru2026/, fuera del
# web root. Estas reglas son una segunda barrera, no la principal.
*.ini
!.env.example
*.env
.env*
*.pem
*.key
*.p12
*.pfx

# Real tally sheets: the PAdES signature carries personal data of the
# polling station members. Only synthetic fixtures under tests/ are versioned.
data/records/
data/custody/

# Derived artefacts: regenerated by tools/render_pages.py
data/cache/
data/og/
data/pages/

# Logs y temporales
error_log
*.log
.DS_Store
__pycache__/
*.pyc
venv/
.venv/
