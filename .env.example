# Copy to a location OUTSIDE the repository, chmod 600, and point
# APP_ENV_FILE at it. Never commit a filled-in copy.
#
#   cp .env.example /etc/visor-actas/.env
#   chmod 600 /etc/visor-actas/.env
#   export APP_ENV_FILE=/etc/visor-actas/.env

APP_ENV=development
APP_BASE_URL=https://verifica.onpe.gob.pe
APP_ROOT_PATH=
APP_DEFAULT_LOCALE=es
APP_DEFAULT_THEME=light

# Attestation API.
#
# STAMPING_TOKEN is optional but RECOMMENDED, and a read-only token is enough.
# The transaction id is derived from the file hash, so a second account that
# seals the same document produces a row with the same id, and the public
# lookup returns whichever was registered last - the impostor's. With a token
# the query is scoped to your own account and returns yours.
#
# Without a token the viewer still refuses to show someone else's record,
# because EXPECTED_ISSUER_ID catches it - but it reports the sheet as still
# in transit rather than showing the real one. Two defences for the same
# attack: the token recovers the right record, the issuer check makes sure a
# wrong one is never presented as verified.
STAMPING_BASE_URL=https://api.stamping.io
STAMPING_TOKEN=
STAMPING_TIMEOUT=30

# ── Custody: where the signed PDFs live ──────────────────────────────
# This is the component the client replaces. Pick a driver and fill in
# only the settings that driver needs. To plug in your own system, see
# app/services/custody/__init__.py.
#
#   local  reads <CUSTODY_PATH>/<identifier>.pdf
#   s3     reads s3://<CUSTODY_BUCKET>/<CUSTODY_PATH>/<identifier>.pdf
#          Works with AWS and any S3-compatible service via CUSTODY_ENDPOINT.
CUSTODY_DRIVER=local

# local: filesystem root. s3: key prefix inside the bucket (may be empty).
CUSTODY_PATH=/var/lib/visor-actas/custody

# s3 only. Leave the keys empty to use an instance role or the shared
# credentials file, which is the preferred setup on AWS.
# CUSTODY_BUCKET=onpe-actas-2026
# CUSTODY_REGION=us-east-1
# CUSTODY_ENDPOINT=https://s3.example.com
# CUSTODY_ACCESS_KEY=
# CUSTODY_SECRET_KEY=

# -- QR code -----------------------------------------------------------
# Which class turns the printed code into an internal identifier. The
# default seals the identifier inside the code itself; a deployment that
# prefers short codes backed by a lookup table registers its own. See the
# README section on changing the resolver.
CODE_RESOLVER=aes-gcm

# 32-byte hex key, used by the aes-gcm resolver
CODE_CIPHER_KEY=

# Derived artefacts (rendered pages, Open Graph cards)
CACHE_PATH=/var/lib/visor-actas/cache

# -- Anchors ----------------------------------------------------------
# Networks the platform records evidence on, and where a citizen is sent to
# check it independently. {value} is replaced by the transaction hash or the
# CID; {trxid} by the transaction id. If an explorer moves, fix it here
# instead of shipping a release.
# Use a gateway you control. A public one takes the citizen off your
# infrastructure mid-verification and can rate-limit or disappear.
IPFS_GATEWAY=https://ipfs.stamping.io/{value}
LACCHAIN_CHAIN_ID=648541
LACCHAIN_EXPLORER=https://explorer.lacnet.com/tx/{value}
ROLLUX_CHAIN_ID=570
ROLLUX_EXPLORER=https://explorer.rollux.com/tx/{value}
MERKLE_VIEWER=https://stamping.io/es/view/?{trxid}

# -- Rate limiting and cache ------------------------------------------
# Deliberately generous. Mobile carriers put thousands of subscribers
# behind one address, so a tight limit locks out a city rather than an
# abuser. The cache is the real defence; this only stops a sustained
# burst.
#
# RATE_LIMIT_BURST      requests allowed back to back. A normal visit
#                       spends about eight, so going below 20 starts
#                       refusing people who did nothing unusual.
# RATE_LIMIT_PER_SECOND sustained rate once the burst is spent.
# RATE_LIMIT_ENABLED    false only for your own load testing.
RATE_LIMIT_BURST=60
RATE_LIMIT_PER_SECOND=4
RATE_LIMIT_ENABLED=true

# How long a verified record is served from memory, in seconds. An attested
# record does not change; this only delays noticing the anchor for one that
# was pending, and those are not cached.
RECORD_CACHE_SECONDS=60

# -- Expected issuer ---------------------------------------------------
# The account that must have registered the sheet. The transaction id is
# derived from the file hash, so anyone sealing the same PDF under their
# own account produces a matching record: without this check the viewer
# confirms that SOMEBODY sealed the document, not that the electoral body
# did.
#
# Leaving it empty disables the check. Not advisable in production.
EXPECTED_ISSUER_ID=
EXPECTED_ISSUER_NAME=

# -- Nodes for independent verification --------------------------------
# The verifier queries the chain directly, without going through the
# attestation service or its infrastructure. Pointing at a node the entity
# operates is what makes the verification independent: using the
# provider's node would mean trusting the party being checked.
#
# LACChain is public-permissioned. There are no published open endpoints;
# nodes are obtained by registering with the LACChain Alliance. Without
# this value the LACChain anchor is simply not verified.
LACCHAIN_RPC=
ROLLUX_RPC=https://rpc.rollux.com
RPC_TIMEOUT=15
