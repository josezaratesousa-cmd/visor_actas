# Copy to a location OUTSIDE the repository, chmod 600, and point
# APP_ENV_FILE at it. Never commit a filled-in copy.
#
#   cp .env.example /etc/visor-actas/.env
#   chmod 600 /etc/visor-actas/.env
#   export APP_ENV_FILE=/etc/visor-actas/.env

APP_ENV=development
APP_BASE_URL=https://verifica.onpe.gob.pe
APP_ROOT_PATH=
APP_DEFAULT_LOCALE=es
APP_DEFAULT_THEME=light

# Attestation API.
# STAMPING_TOKEN is OPTIONAL and can be left empty: the viewer only uses the
# public lookup by transaction id. Leaving it empty is the safer deployment -
# there is then no credential on the machine that faces the public.
# The registration tool in tools/ does need one.
STAMPING_BASE_URL=https://api.stamping.io
STAMPING_TOKEN=
STAMPING_TIMEOUT=30

# ── Custody: where the signed PDFs live ──────────────────────────────
# This is the component the client replaces. Pick a driver and fill in
# only the settings that driver needs. To plug in your own system, see
# app/services/custody/__init__.py.
#
#   local  reads <CUSTODY_PATH>/<identifier>.pdf
#   s3     reads s3://<CUSTODY_BUCKET>/<CUSTODY_PATH>/<identifier>.pdf
#          Works with AWS and any S3-compatible service via CUSTODY_ENDPOINT.
CUSTODY_DRIVER=local

# local: filesystem root. s3: key prefix inside the bucket (may be empty).
CUSTODY_PATH=/var/lib/visor-actas/custody

# s3 only. Leave the keys empty to use an instance role or the shared
# credentials file, which is the preferred setup on AWS.
# CUSTODY_BUCKET=onpe-actas-2026
# CUSTODY_REGION=us-east-1
# CUSTODY_ENDPOINT=https://s3.example.com
# CUSTODY_ACCESS_KEY=
# CUSTODY_SECRET_KEY=

# 32-byte hex key used to decipher the QR code parameter
CODE_CIPHER_KEY=

# Derived artefacts (rendered pages, Open Graph cards)
CACHE_PATH=/var/lib/visor-actas/cache

# -- Anchors ----------------------------------------------------------
# Networks the platform records evidence on, and where a citizen is sent to
# check it independently. {value} is replaced by the transaction hash or the
# CID; {trxid} by the transaction id. If an explorer moves, fix it here
# instead of shipping a release.
IPFS_GATEWAY=https://ipfs.io/ipfs/{value}
LACCHAIN_CHAIN_ID=648541
LACCHAIN_EXPLORER=https://explorer.lacnet.com/tx/{value}
ROLLUX_CHAIN_ID=570
ROLLUX_EXPLORER=https://explorer.rollux.com/tx/{value}
MERKLE_VIEWER=https://stamping.io/es/view/?{trxid}
