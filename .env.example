# Copy to a location OUTSIDE the repository, chmod 600, and point
# APP_ENV_FILE at it. Never commit a filled-in copy.
#
#   cp .env.example /home/votolibre/config/peru2026/.env
#   chmod 600 /home/votolibre/config/peru2026/.env

APP_ENV=development
APP_BASE_URL=https://votolibre.info/peru/2026
APP_ROOT_PATH=/peru/2026
APP_DEFAULT_LOCALE=es
APP_DEFAULT_THEME=light

# Stamping API - evidence registration and lookup
STAMPING_BASE_URL=https://api.stamping.io
STAMPING_TOKEN=
STAMPING_TIMEOUT=30

# Where the signed PDFs live
CUSTODY_DRIVER=local
CUSTODY_PATH=/home/votolibre/custody/peru2026
# CUSTODY_BUCKET=
# CUSTODY_REGION=
# CUSTODY_ENDPOINT=
# CUSTODY_ACCESS_KEY=
# CUSTODY_SECRET_KEY=

# 32-byte hex key used to decipher the QR code parameter
CODE_CIPHER_KEY=

# Derived artefacts (rendered pages, Open Graph cards)
CACHE_PATH=/home/votolibre/custody/peru2026/cache
