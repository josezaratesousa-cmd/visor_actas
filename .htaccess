# ── Nunca servir credenciales, fuentes ni código de servidor ──
<FilesMatch "\.(ini|env|pem|key|p12|pfx|log|py|sh|md|sql)$">
  Require all denied
</FilesMatch>
<Files "error_log">
  Require all denied
</Files>
<Files ".gitignore">
  Require all denied
</Files>
RedirectMatch 404 /\.git

Options -Indexes

# ── Cabeceras de seguridad ──
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"

# ── Enrutado: /peru/2026/<codigo> → index.php ──
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_-]{6,32})/?$ index.php?c=$1 [QSA,L]

# ── En desarrollo: sin caché de código, para no mezclar versiones ──
<FilesMatch "\.(js|css|json)$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
</FilesMatch>
